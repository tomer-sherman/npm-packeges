{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true, // it skips compilation errors of the inner libaries.
        "types": ["node"],
        "declaration": true, // makes the compiler, use d.ts enthelisence // makes the user, have the ability to import
        "removeComments": true,
        "outDir": "build",
        "rootDir": "src"
    }
}
    