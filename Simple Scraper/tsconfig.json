{
    "compilerOptions":{
        
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "strict": true,
        "types": ["node"],
        "declaration": true,
        "removeComments": true,
        "outDir": "build",
        "rootDir": "src"

    },
    "include": ["src"],
    "exclude": ["src/test", "src/util"]
}